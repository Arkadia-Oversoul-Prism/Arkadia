# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.venv/
venv/
env/

# Database
*.db
*.sqlite
*.sqlite3
arkadia_oracle.db
# tests/test_oracle_spine.py names its scratch DB `_spine_test.db` directly in
# tests/. The `*.db` rule covers the database file but not the `-wal`/`-shm`
# sidecars SQLite leaves behind in WAL mode, so cover the whole family.
tests/_spine_test.db*

# The canonical SolSpire store is an untracked runtime database in WAL mode, so a
# test session that reaches it leaves `-wal`/`-shm` siblings that `*.db` misses.
# `tests/test_repo_hygiene_gitignore.py` pins the whole family.
data/solspire_projects.db*

# API key stores (contain sensitive credentials — never commit)
data/api_keys.json
data/provider_keys.json
data/user_keys/
data/ims_credentials_sealed.json

# Cache files
arkadia_cache.json
arkadia_corpus_map.json

# Service account files
service_account.json
/run/service_account.json

# Environment files
.env
.env.local

# Logs
*.log

# Backup files
*.bak
*.old

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
arkadia-android/.gradle/
arkadia-android/app/build/
arkadia-android/gradlew
# Session evidence: per-run generated reports are transient, but acceptance
# records are durable review state that a later scheduler wake must be able to
# reconstruct the trajectory from. Ignore the generated reports, not the tree.
docs/control-plane/evidence/**/session-report.json
docs/control-plane/evidence/**/WEAVER-ENGINEERING-RUN.md
# The attention outbox is a local relay appended to on every worker run; it is
# runtime output, not review state, so `git add -A` must not stage it.
docs/control-plane/evidence/**/attention-events.jsonl
# The scheduler writes its run result to the repository root before uploading it
# as a build artifact. It is the same class of transient output as the per-run
# reports above, so `git add -A` must not stage it.
engineering-session-result.json
!docs/control-plane/evidence/README.md

# Knowledge OS private vault: generated runtime output must never be committed.
# Tracked scaffolding (.gitkeep, Index/README.md, Templates/) is preserved.
vault/**
!vault/**/
!vault/**/.gitkeep
!vault/Index/README.md
!vault/Templates/**
