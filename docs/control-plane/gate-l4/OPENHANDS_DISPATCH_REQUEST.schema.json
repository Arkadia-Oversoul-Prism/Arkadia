{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkadia.local/schemas/gate-l4-openhands-dispatch-request.schema.json",
  "title": "GATE L4 OpenHands Dispatch Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["assignment_id", "lane", "base_sha", "instruction", "idempotency_key"],
  "properties": {
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z0-9][A-Z0-9._:-]*$"
    },
    "lane": { "enum": ["W1", "W2", "W3", "W4"] },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "instruction": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "idempotency_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
