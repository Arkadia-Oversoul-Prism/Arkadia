{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkadia.local/control-plane/trajectory.schema.json",
  "title": "Arkadia Trajectory",
  "type": "object",
  "required": ["trajectory", "moves"],
  "additionalProperties": true,
  "properties": {
    "trajectory": {
      "type": "object",
      "required": ["id", "version", "status", "max_active_moves", "merge", "production_deploy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": ["integer", "string"] },
        "status": { "type": "string" },
        "objective": { "type": "string" },
        "authority_level": { "type": ["integer", "string"] },
        "execution_mode": { "type": "string" },
        "max_active_moves": { "type": "integer", "minimum": 1 },
        "review_gate": { "type": "string" },
        "merge": { "type": "string" },
        "production_deploy": { "type": "string" },
        "constitutional_changes": { "type": "string" },
        "forbidden": { "type": "array", "items": { "type": "string" } },
        "amendment_note": { "type": "string" }
      }
    },
    "moves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "spec"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "revision_required", "completed", "accepted", "blocked", "failed", "aborted"]
          },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "packet": { "type": "string" },
          "spec": { "type": "string" }
        }
      }
    },
    "routing_invariants": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
